{
  "manifest_version": 3,
  "name": "HarnessStation Browser Bridge",
  "version": "1.0.0",
  "description": "Lets HarnessStation drive this browser, using the sessions you are already signed in to.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "windows",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "HarnessStation bridge",
    "default_popup": "popup.html"
  },
  "icons": {}
}
