# Artificial Analysis — powers the Benchmarks view.
# Free key at https://artificialanalysis.ai/api
AA_API_KEY=

# Optional
PORT=8787
REFRESH_MINUTES=30
RATE_LIMIT=60

# Trial links (?trial=CODE) resolve to a provider bundle from this file.
# Copy trials.example.json -> trials.json and fill in real keys. Leave unset to
# use ./trials.json next to index.mjs.
# TRIALS_FILE=./trials.json

# --- Community library ---
# REQUIRED in production: a private random salt so stored like/report keys can't
# be reversed to raw IPs. Generate with: openssl rand -hex 16
LIBRARY_SALT=
# Bearer token for the admin moderation routes (GET /api/admin/library,
# POST /api/admin/library/:id). If unset, those routes are disabled.
LIBRARY_ADMIN_TOKEN=
# Publishes allowed per IP per hour, and how many distinct reports auto-hide an
# item pending review.
# LIBRARY_PUBLISH_LIMIT=10
# LIBRARY_REPORT_THRESHOLD=4
# Where the library is stored (defaults to ./library.json next to index.mjs).
# LIBRARY_FILE=./library.json
